# Template for ~/.hermes/.env — copy values in there, never commit real keys.
# Hermes reads its own ~/.hermes/.env; this file documents what it needs.

# --- Model provider -------------------------------------------------------
# Gemini is first-class in Hermes and has a large free-tier allowance.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Not used for chat. Groq's free tier caps at 8,000 tokens/minute, which is
# below Hermes' baseline request size. Kept only for Whisper transcription.
GROQ_API_KEY=

# --- Email gateway (not yet configured) -----------------------------------
# Use a DEDICATED mailbox. Hermes stores this password on disk and takes full
# IMAP access to the inbox — it must not sit on a shared human inbox.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_ALLOWED_SENDERS=
# EMAIL_POLL_INTERVAL=15

# --- Slack gateway (not yet configured) -----------------------------------
# Generate the app manifest with: hermes slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- HubSpot (not yet configured) -----------------------------------------
# Private app token, scoped to reading contacts and their properties.
HUBSPOT_ACCESS_TOKEN=
